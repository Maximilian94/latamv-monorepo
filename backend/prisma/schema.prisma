// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  GOLD
}

model Subsidiary {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  icaoCode    String   @unique
  description String?
  country     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bases Base[]
  users User[]
}

model Base {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  city         String
  state        String
  country      String      @default("BR")
  subsidiaryId Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subsidiary   Subsidiary  @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  users        User[]
  baseAirports BaseAirport[]
}

model BaseAirport {
  id        Int      @id @default(autoincrement())
  baseId    Int
  airportCode String
  createdAt DateTime @default(now())

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@unique([baseId, airportCode])
}

model Route {
  id                  Int      @id
  ident_icao          String?
  ident_iata          String?
  aircraft_model_code String
  departure_icao      String
  arrival_icao        String
  eet                 Int
  updated_at          DateTime @updatedAt
  available           Boolean  @default(true)

  aircraft_model AircraftModel @relation(fields: [aircraft_model_code], references: [code])
  routeAircraft  RouteAircraft[]
}

model AircraftModel {
  model        String
  code         String @id
  manufacturer String

  Route     Route[]
  aircrafts Aircraft[]
}

model FlightDuty {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime
  expirationDate       DateTime
  userId               Int
  aircraftRegistration String
  isClosed             Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id])
  flights  Flight[]
  aircraft Aircraft @relation(fields: [aircraftRegistration], references: [registration])
}

model Flight {
  id                          Int       @id @default(autoincrement())
  flightDutyId                Int
  userId                      Int
  aircraftRegistration        String
  aircraftModel               String
  isClosed                    Boolean   @default(false)
  index                       Int
  startAcarsTime              DateTime?
  endAcarsTime                DateTime?
  OUT                         DateTime?
  OFF                         DateTime?
  ON                          DateTime?
  IN                          DateTime?
  score                       Int?
  amountOfProactiveExcellence Int?
  amountOfStandardCompliance  Int?
  amountOfProceduralDeviation Int?
  amountOfSafetyCompromise    Int?
  isReviewed                  Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  flightNumber                String
  departureIcao               String
  arrivalIcao                 String
  eet                         Int

  user         User          @relation(fields: [userId], references: [id])
  flightDuty   FlightDuty    @relation(fields: [flightDutyId], references: [id])
  flightEvents FlightEvent[]
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  users          User[]           @relation("UserRoles")
  RolePermission RolePermission[]
}

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  username     String      @unique
  password     String
  plan         Plan        @default(FREE)
  baseId       Int
  subsidiaryId Int

  subsidiary   Subsidiary  @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  base         Base        @relation(fields: [baseId], references: [id])
  roles        Role[]      @relation("UserRoles")
  flights      Flight[]
  flightDuties FlightDuty[]
  userAwards   UserAward[]
  exams        Exam[]
  createdAt    DateTime    @default(now())
  updateAt     DateTime    @default(now()) @updatedAt
}



model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  groupId         Int
  RolePermission  RolePermission[]
  permissionGroup PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model PermissionGroup {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  Permission  Permission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Aircraft {
  registration      String  @id @db.VarChar(255)
  type              String
  engine            String
  active            Boolean
  aircraftModelCode String
  available         Boolean @default(true)

  aircraftModel AircraftModel @relation(fields: [aircraftModelCode], references: [code])
  FlightDuty    FlightDuty[]
}

model Severity {
  id          Int     @id
  name        String  @unique
  points      Int
  description String
  events      Event[]
}

model Event {
  id         String  @id
  name       String
  severityId Int
  reference  String?

  severity         Severity          @relation(fields: [severityId], references: [id])
  flightEvents     FlightEvent[]
  eventDescription EventDescription?
}

model EventDescription {
  eventID     String @id
  description String

  event Event @relation(fields: [eventID], references: [id], onDelete: Cascade)
}

model FlightEvent {
  id        Int      @id @default(autoincrement())
  flightId  Int
  eventId   String
  timestamp DateTime // Quando o evento ocorreu
  details   Json? // Detalhes adicionais do evento (ex.: velocidade, altitude)
  flight    Flight   @relation(fields: [flightId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
}

model RouteAircraft {
  id        Int      @id @default(autoincrement())
  routeId   Int
  aircraftType String

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, aircraftType])
}

model Award {
  id               Int         @id @default(autoincrement())
  name             String      @unique
  image            String?
  description      String
  tooltip          String
  validityDuration Int         // Duration in days
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  userAwards UserAward[]
}

model UserAward {
  id         Int      @id @default(autoincrement())
  userId     Int
  awardId    Int
  obtainedAt DateTime @default(now())
  expiresAt  DateTime
  updatedAt  DateTime @default(now()) @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  award Award @relation(fields: [awardId], references: [id], onDelete: Cascade)

  @@unique([userId, awardId])
}

// ===== EXAM SYSTEM =====

model QuestionTag {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  color       String     @default("#3B82F6")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions Question[]
  examTemplateTags ExamTemplateTag[]
}

model Question {
  id          Int        @id @default(autoincrement())
  tagId       Int
  statement   String
  imageUrl    String?
  videoUrl    String?
  explanation String?
  difficulty  Int        @default(3) // 1-5 scale
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tag           QuestionTag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  alternatives  QuestionAlternative[]
  examQuestions ExamQuestion[]
}

model QuestionAlternative {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String
  isCorrect  Boolean

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamTemplate {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  questionCount Int
  timeLimit    Int        // Time limit in minutes
  passingScore Int        // Minimum score to pass (0-100)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  examTemplateTags ExamTemplateTag[]
  exams           Exam[]
}

model ExamTemplateTag {
  examTemplateId Int
  questionTagId  Int
  questionCount  Int // Number of questions from this tag

  examTemplate ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  questionTag  QuestionTag  @relation(fields: [questionTagId], references: [id], onDelete: Cascade)

  @@id([examTemplateId, questionTagId])
}

enum ExamStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

model Exam {
  id             Int        @id @default(autoincrement())
  examTemplateId Int
  userId         Int
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  score          Int?       // Final score (0-100)
  isPassed       Boolean?
  timeSpent      Int?       // Time spent in seconds
  status         ExamStatus @default(IN_PROGRESS)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  examTemplate   ExamTemplate   @relation(fields: [examTemplateId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  examQuestions  ExamQuestion[]
}

model ExamQuestion {
  id          Int        @id @default(autoincrement())
  examId      Int
  questionId  Int        // Reference to original question
  statement   String     // Immutable copy of statement
  imageUrl    String?    // Immutable copy of image URL
  videoUrl    String?    // Immutable copy of video URL
  explanation String?    // Immutable copy of explanation
  difficulty  Int        // Immutable copy of difficulty
  tagName     String     // Immutable copy of tag name
  order       Int        // Question order in exam
  timeSpent   Int?       // Time spent on this question in seconds
  createdAt   DateTime   @default(now())

  exam                Exam                    @relation(fields: [examId], references: [id], onDelete: Cascade)
  question            Question                @relation(fields: [questionId], references: [id])
  examQuestionAlternatives ExamQuestionAlternative[]
}

model ExamQuestionAlternative {
  id              Int      @id @default(autoincrement())
  examQuestionId  Int
  text            String   // Immutable copy of alternative text
  isCorrect       Boolean  // Immutable copy of correct flag
  selectedByUser  Boolean  @default(false)
  order           Int      // Shuffled order (A=1, B=2, C=3, D=4)

  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
}
