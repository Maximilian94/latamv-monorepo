generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Base {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String?
  city         String
  state        String
  country      String        @default("BR")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  baseAirports BaseAirport[]
  users        User[]
}

model BaseAirport {
  id          Int      @id @default(autoincrement())
  baseId      Int
  airportCode String
  createdAt   DateTime @default(now())
  base        Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@unique([baseId, airportCode])
}

model Route {
  weekday             String?
  flight_number       String          @id
  departure_icao      String
  eobt                String?
  speed               String?
  flight_level        String?
  route               String?
  arrival_icao        String
  rmk                 String?
  aircraft_model_code String?
  updated_at          DateTime        @updatedAt
  available           Boolean         @default(true)
  eet_seconds         Int?
  eet_old             String?
  ident_iata          String?
  ident_icao          String?
  flights             Flight[]
  routeAircraft       RouteAircraft[]
}

model RouteAircraft {
  flight_number String
  aircraft_code String
  aircraftModel AircraftModel @relation(fields: [aircraft_code], references: [code], onDelete: Cascade)
  route         Route         @relation(fields: [flight_number], references: [flight_number], onDelete: Cascade)

  @@id([flight_number, aircraft_code])
}

model AircraftModel {
  model         String
  code          String          @id
  manufacturer  String
  aircrafts     Aircraft[]
  routeAircraft RouteAircraft[]
}

model FlightDuty {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime
  expirationDate       DateTime
  userId               Int
  aircraftRegistration String
  isClosed             Boolean  @default(false)
  flights              Flight[]
  aircraft             Aircraft @relation(fields: [aircraftRegistration], references: [registration])
  user                 User     @relation(fields: [userId], references: [id])
}

model Flight {
  id                          Int           @id @default(autoincrement())
  flightDutyId                Int
  routeId                     String
  userId                      Int
  aircraftRegistration        String
  isClosed                    Boolean       @default(false)
  index                       Int
  IN                          DateTime?
  OFF                         DateTime?
  ON                          DateTime?
  OUT                         DateTime?
  endAcarsTime                DateTime?
  startAcarsTime              DateTime?
  score                       Int?
  amountOfProactiveExcellence Int?
  amountOfProceduralDeviation Int?
  amountOfSafetyCompromise    Int?
  amountOfStandardCompliance  Int?
  isReviewed                  Boolean       @default(false)
  createdAt                   DateTime      @default(now())
  aircraft                    Aircraft      @relation(fields: [aircraftRegistration], references: [registration])
  flightDuty                  FlightDuty    @relation(fields: [flightDutyId], references: [id])
  route                       Route         @relation(fields: [routeId], references: [flight_number])
  user                        User          @relation(fields: [userId], references: [id])
  flightEvents                FlightEvent[]
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  RolePermission RolePermission[]
  UserRole       UserRole[]
  users          User[]           @relation("UserRoles")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  password     String
  username     String       @unique
  createdAt    DateTime     @default(now())
  updateAt     DateTime     @default(now()) @updatedAt
  plan         Plan         @default(FREE)
  baseId       Int
  flights      Flight[]
  flightDuties FlightDuty[]
  base         Base         @relation(fields: [baseId], references: [id])
  UserRole     UserRole[]
  roles        Role[]       @relation("UserRoles")
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  groupId         Int
  permissionGroup PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  RolePermission  RolePermission[]
}

model PermissionGroup {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  Permission  Permission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Aircraft {
  registration      String        @id @db.VarChar(255)
  type              String
  engine            String
  active            Boolean
  aircraftModelCode String
  available         Boolean       @default(true)
  aircraftModel     AircraftModel @relation(fields: [aircraftModelCode], references: [code])
  Flight            Flight[]
  FlightDuty        FlightDuty[]
}

model Severity {
  id          Int     @id
  name        String  @unique
  points      Int
  description String
  events      Event[]
}

model Event {
  id               String            @id
  name             String
  severityId       Int
  reference        String?
  severity         Severity          @relation(fields: [severityId], references: [id])
  eventDescription EventDescription?
  flightEvents     FlightEvent[]
}

model EventDescription {
  eventID     String @id
  description String
  event       Event  @relation(fields: [eventID], references: [id], onDelete: Cascade)
}

model FlightEvent {
  id        Int      @id @default(autoincrement())
  flightId  Int
  eventId   String
  timestamp DateTime
  details   Json?
  event     Event    @relation(fields: [eventId], references: [id])
  flight    Flight   @relation(fields: [flightId], references: [id])
}

enum Plan {
  FREE
  GOLD
}
